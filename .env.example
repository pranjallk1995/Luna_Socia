# Copy this file to .env and replace every placeholder before starting Socia.

# Socia's database role password: the same value as LUNASOCIA_DB_PASSWORD in Luna_Sentia/.env.
POSTGRES_PASSWORD=lunasocia-dev

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network. Only the owner can open Socia.
LUNA_SSO_URL=https://auth.example.com
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000

# Where browsers open Socia: route it to 127.0.0.1:18507. Like every app it must sit under
# SENTIA_AUTH_COOKIE_DOMAIN, so the sign-in reaches it.
UI_PUBLIC_URL=https://socia.example.com

# Her chat model and the model that looks at photos; both must be in SENTIA_MODELS in
# Luna_Sentia/.env, which pulls them into the shared Ollama.
LUNASOCIA_CHAT_MODEL=qwen3:14b
LUNASOCIA_VISION_MODEL=qwen3-vl:8b-instruct
# Her context; it must equal SENTIA_RESIDENT_CONTEXT in Luna_Sentia/.env, where her chat
# model is the resident model that stays on the GPU.
LUNASOCIA_CONTEXT_TOKENS=8192

# Voice, on the CPU: Whisper for voice messages, a Kokoro voice for her replies.
LUNASOCIA_STT_MODEL=large-v3-turbo
LUNASOCIA_TTS_VOICE=af_heart
